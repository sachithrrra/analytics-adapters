{
  "name": "analytics-adapters",
  "version": "1.3.0",
  "description": "One analytics API with swappable provider adapters and framework integrations.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./google": {
      "types": "./dist/google.d.ts",
      "default": "./dist/google.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./tanstack": {
      "types": "./dist/tanstack.d.ts",
      "default": "./dist/tanstack.js"
    },
    "./plausible": {
      "types": "./dist/plausible.d.ts",
      "default": "./dist/plausible.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sachithrrra/analytics-adapters.git",
    "directory": "packages/analytics-adapters"
  },
  "homepage": "https://github.com/sachithrrra/analytics-adapters#readme",
  "bugs": {
    "url": "https://github.com/sachithrrra/analytics-adapters/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@plausible-analytics/tracker": ">=0.4",
    "@tanstack/react-router": ">=1",
    "next": ">=14",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "@plausible-analytics/tracker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@plausible-analytics/tracker": "^0.4.6",
    "@tanstack/react-router": "^1.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "analytics",
    "google-analytics",
    "plausible",
    "ga4",
    "gtag",
    "nextjs",
    "tanstack",
    "astro"
  ],
  "dependencies": {
    "@types/gtag.js": "^0.0.20"
  }
}
